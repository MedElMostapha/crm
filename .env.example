# ------------------------------------------------------------------
# Orbit CRM environment variables
# Copy to .env.local for local dev, and set the SAME values in your
# Vercel project settings (Project -> Settings -> Environment
# Variables) for production.
# ------------------------------------------------------------------

# Turso database (Vercel integration creates TURSO_DATABASE_URL /
# TURSO_AUTH_TOKEN automatically - those are read first).
# Legacy DATABASE_URL / DATABASE_AUTH_TOKEN names are also supported.
DATABASE_URL="libsql://your-database-your-org.turso.io"
DATABASE_AUTH_TOKEN="your-turso-auth-token"

# Better Auth - server side
# Generate with: openssl rand -base64 32
# Legacy AUTH_SECRET / AUTH_URL names are also supported (fallback).
BETTER_AUTH_SECRET="<openssl rand -base64 32>"
BETTER_AUTH_URL="https://your-project.vercel.app"

# Browser auth base URL - IMPORTANT: this value is inlined into the
# client bundle at build time. Use the production domain on Vercel,
# never http://localhost for deployments.
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"